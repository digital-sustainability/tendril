# ──────────────────────────────────────────────────────────────────────────────
# TENDRIL — environment variables for the LLM judge and the API embedding models
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` in the project root and fill in the values you need:
#
#     cp .env.example .env
#
# Every variable is optional: only the client(s) you actually use require their
# key to be set. Each client validates its own key at construction time and
# raises a targeted ValueError when it is missing.

# ── LLM judge and restriction filter ─────────────────────────────────────────

# OpenRouter (required by OpenRouterClient)
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── OpenRouter request metadata (optional; provider-side log attribution) ────
# Sent as HTTP-Referer / X-Title headers with every OpenRouter request.
# OPENROUTER_REFERER=https://tendril-project.local
# OPENROUTER_APP_NAME=TENDRIL

# Fixed-rate ResponsibleRequest defaults for `client: openrouter`.
# Judge YAML `throttle` / `timeout` / `max_retries` win when a runner builds
# the client. These are the fallback for direct client use. The SQLite path
# is that fallback log; experiment runners log beside run.log.
# OPENROUTER_RR_RPM=60
# OPENROUTER_RR_MAX_CONCURRENCY=10
# OPENROUTER_RR_CONSOLE_LEVEL=INFO
# OPENROUTER_RR_LOG_SQLITE=logs/responsible_request.sqlite

# ── Outbound LLM client resilience ───────────────────────────────────────────
# Per-request timeout in seconds. Judge YAML `runtime.timeout` overrides this.
# LLM_TIMEOUT=60.0
# SDK-level retries for transient failures (connection/timeout/429/5xx).
# Judge YAML `runtime.max_retries` overrides this.
# LLM_MAX_RETRIES=2

# ── Embedding APIs (evaluation only) ─────────────────────────────────────────
# OpenAI, Voyage and Gemini embeddings in src/tendril/models/registry.py.
OPENAI_API_KEY=
VOYAGE_API_KEY=
GEMINI_API_KEY=
